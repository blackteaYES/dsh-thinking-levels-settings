{
  "name": "dsh-thinking-levels-settings",
  "version": "3.0.0",
  "description": "Persistent per-model thinking-level settings for custom DSH providers (official dsh client-plugin form)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "INSTALL.md",
    "cordis.patch.yml",
    "INSTALL.html",
    "README.md",
    "LICENSE",
    "install.sh"
  ],
  "scripts": {
    "types": "tsc --declaration --emitDeclarationOnly --outDir lib/types --noEmit false --rootDir src --project tsconfig.json",
    "bundle": "tsdown && npm run types",
    "watch": "tsdown --watch",
    "prepare": "npm run bundle"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "private": true,
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
